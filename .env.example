# Copy to .env and replace every change-me value. .env is git-ignored.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"

# Postgres superuser for the local docker-compose database
POSTGRES_PASSWORD=change-me

# Schema owner (migrations only) and the least-privileged app role (runtime).
DATABASE_OWNER_URL=postgres://keyresult_owner:change-me@localhost:5433/keyresult
DATABASE_URL=postgres://keyresult_app:change-me-too@localhost:5433/keyresult

# Public URL of the app (used for invite links and Stripe redirects)
APP_URL=http://localhost:3000

# Optional: Stripe test mode billing. Leave empty to disable billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
